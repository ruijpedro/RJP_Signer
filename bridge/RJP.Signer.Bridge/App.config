<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Compatibilidade DWFx Autodesk/Design Review:
         .NET Framework 4.7.1+ mudou o SignedXml RSA predefinido de SHA-1 para SHA-256.
         Este Bridge repõe SHA-1 apenas no motor legado DWFx. -->
    <AppContextSwitchOverrides value="Switch.System.Security.Cryptography.Xml.UseInsecureHashAlgorithms=true" />
  </runtime>
  <appSettings>
    <!-- Altera este URL se publicares a WebApp noutro repositório GitHub Pages. -->
    <add key="WebAppUrl" value="https://ruijpedro.github.io/RJP_Signer/" />
  </appSettings>
</configuration>
